APP_NAME=DocumentToMarkdown
DATA_DIR=./data
MAX_UPLOAD_SIZE_MB=100
API_PREFIX=/api
CONVERT_TIMEOUT_SECONDS=300
MAX_CONCURRENT_CONVERSIONS=2
TASK_WORKER_COUNT=1
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
SESSION_SECRET=please-change-this-secret
SESSION_EXPIRE_HOURS=12
# Optional worker id for generated snowflake file IDs. Use a different value per service instance.
# SNOWFLAKE_WORKER_ID=1
# Optional. Use after running: .\.venv\Scripts\docling-tools.exe models download --output-dir ./models/docling
# DOCLING_ARTIFACTS_PATH=./models/docling
